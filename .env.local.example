# Copy to .env.local and fill in real values. Never commit .env.local.
# GET /api/health reports which of the required vars below are missing.

# --- Required ---

# CricketData.org (formerly CricAPI) API key. Free tier is capped at 100
# hits/day, so this is only ever read by the Vercel Cron refresh job
# (app/api/cron/refresh-cricket-data), never by a live user request.
CRICKETDATA_API_KEY=your_cricketdata_org_key_here

# OpenWeatherMap API key. Called on-demand (not via cron) since the free
# quota is generous; cached in Mongo with a 3-hour TTL.
OPENWEATHER_API_KEY=your_openweathermap_key_here

# MongoDB Atlas connection string (free M0 tier). All cached cricket/weather
# data and prediction logs live here. The app falls back to an in-process
# mock data set if unset so local UI work never blocks on Atlas being
# provisioned — but /api/health will flag it missing.
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Random secret Vercel sends as `Authorization: Bearer <CRON_SECRET>` on
# cron invocations (set the same value as a Vercel project env var). The
# refresh route rejects any request that doesn't present it. Generate one
# with e.g. `openssl rand -hex 32`.
CRON_SECRET=your_generated_random_secret_here

# --- Optional ---

MONGODB_DB_NAME=cric11

# "mock" (default, no key needed) | "cricketdata" | "cricbuzz"
CRICKET_API_PROVIDER=mock

CRICKETDATA_BASE_URL=https://api.cricapi.com/v1

# RapidAPI key for the "Cricbuzz Cricket" API (host cricbuzz-cricket.p.rapidapi.com).
# Only read when CRICKET_API_PROVIDER=cricbuzz. Free "Basic" plan is
# 200 requests/month — fine for personal, low-volume use since squads are
# cached in Mongo and only refreshed via cron, not per page view.
RAPIDAPI_KEY=your_rapidapi_key_here

# Required (as `Authorization: Bearer <ADMIN_SECRET>`) to call
# /api/admin/finalize-match, which records a completed match's actual
# results into the track-record page. Unset only for local testing.
ADMIN_SECRET=
